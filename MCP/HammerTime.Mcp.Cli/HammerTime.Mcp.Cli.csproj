<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>hammertime-mcp</AssemblyName>
    <RootNamespace>HammerTime.Mcp.Cli</RootNamespace>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\HammerTime.Mcp.Shared\HammerTime.Mcp.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <ItemGroup>
    <!-- Fallback skill text served when no installed SKILL.md is found. Linked from the single
         canonical copy in MCP-Install; never copied next to the build output. -->
    <EmbeddedResource Include="..\MCP-Install\SKILL.md" Link="SKILL.md" LogicalName="HammerTime.Mcp.Cli.SKILL.md" />
  </ItemGroup>
</Project>
