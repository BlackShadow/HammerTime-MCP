<Project>
  <PropertyGroup>
    <McpBuildInstallBundle Condition="'$(McpBuildInstallBundle)' == '' and '$(BuildingInsideVisualStudio)' == 'true'">true</McpBuildInstallBundle>
    <McpBuildInstallBundle Condition="'$(McpBuildInstallBundle)' == ''">false</McpBuildInstallBundle>
    <McpInstallRoot Condition="'$(McpInstallRoot)' == ''">$(MSBuildThisFileDirectory)MCP-Install\</McpInstallRoot>
    <McpInstallRootDir>$([MSBuild]::EnsureTrailingSlash('$(McpInstallRoot)'))</McpInstallRootDir>
  </PropertyGroup>

  <Target Name="CleanMcpServerBundle"
          BeforeTargets="Build"
          Condition="'$(MSBuildProjectName)' == 'HammerTime.Mcp.Cli' and '$(McpBuildInstallBundle)' == 'true'">
    <RemoveDir Directories="$(McpInstallRootDir)Server" ContinueOnError="true" />
    <MakeDir Directories="$(McpInstallRootDir)Server" />
  </Target>

  <Target Name="CopyMcpServerBundle"
          AfterTargets="Build"
          Condition="'$(MSBuildProjectName)' == 'HammerTime.Mcp.Cli' and '$(McpBuildInstallBundle)' == 'true'">
    <ItemGroup>
      <McpServerBundleFiles Include="$(TargetDir)**\*.*" />
    </ItemGroup>
    <Message Text="[MCP] Copying server bundle to $(McpInstallRootDir)Server\" Importance="high" />
    <Copy SourceFiles="@(McpServerBundleFiles)"
          DestinationFiles="@(McpServerBundleFiles->'$(McpInstallRootDir)Server\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="false" />
    <!-- No SKILL.md copy here: the canonical MCP-Install\SKILL.md is the single source.
         Install resolves it via the exe's ..\SKILL.md fallback (ResolveSkillSourcePath). -->
    <Message Text="[MCP] Server bundle copied." Importance="high" />
  </Target>

  <Target Name="CleanMcpPluginBundle"
          BeforeTargets="Build"
          Condition="'$(MSBuildProjectName)' == 'HammerTime.Mcp.Plugin' and '$(McpBuildInstallBundle)' == 'true'">
    <RemoveDir Directories="$(McpInstallRootDir)Plugin" ContinueOnError="true" />
    <MakeDir Directories="$(McpInstallRootDir)Plugin" />
  </Target>

  <Target Name="CopyMcpPluginBundle"
          AfterTargets="Build"
          Condition="'$(MSBuildProjectName)' == 'HammerTime.Mcp.Plugin' and '$(McpBuildInstallBundle)' == 'true'">
    <ItemGroup>
      <McpPluginBundleFiles Include="$(TargetDir)HammerTime.Mcp.Plugin.dll" Condition="Exists('$(TargetDir)HammerTime.Mcp.Plugin.dll')" />
      <McpPluginBundleFiles Include="$(TargetDir)HammerTime.Mcp.Plugin.pdb" Condition="Exists('$(TargetDir)HammerTime.Mcp.Plugin.pdb')" />
      <McpPluginBundleFiles Include="$(TargetDir)HammerTime.Mcp.Plugin.deps.json" Condition="Exists('$(TargetDir)HammerTime.Mcp.Plugin.deps.json')" />
      <McpPluginBundleFiles Include="$(TargetDir)HammerTime.Mcp.Shared.dll" Condition="Exists('$(TargetDir)HammerTime.Mcp.Shared.dll')" />
      <McpPluginBundleFiles Include="$(TargetDir)HammerTime.Mcp.Shared.pdb" Condition="Exists('$(TargetDir)HammerTime.Mcp.Shared.pdb')" />
      <McpPluginBundleFiles Include="$(PkgNewtonsoft_Json)\lib\net6.0\Newtonsoft.Json.dll" Condition="Exists('$(PkgNewtonsoft_Json)\lib\net6.0\Newtonsoft.Json.dll')" />
    </ItemGroup>
    <Message Text="[MCP] Copying plugin bundle to $(McpInstallRootDir)Plugin\" Importance="high" />
    <Copy SourceFiles="@(McpPluginBundleFiles)"
          DestinationFolder="$(McpInstallRootDir)Plugin\"
          SkipUnchangedFiles="false" />
    <!-- No SKILL.md copy here: nothing reads a plugin-local skill (SkillSummary uses
         config.SkillPath / AppData). Canonical stays at MCP-Install\SKILL.md only. -->
    <Message Text="[MCP] Plugin bundle copied." Importance="high" />
  </Target>
</Project>
